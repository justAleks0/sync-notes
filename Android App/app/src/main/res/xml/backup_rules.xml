<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and older. See data_extraction_rules.xml for 12+.
-->
<full-backup-content>
    <!--
       The AI settings hold the user's own API key - a billable credential. It is
       kept on this device deliberately, so it must not ride out to Google's backup
       either; a restore onto a stranger's phone would hand over a working key.
    -->
    <exclude domain="sharedpref" path="sync-notes-ai.xml"/>
</full-backup-content>
